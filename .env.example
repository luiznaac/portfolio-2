# The env vars portfolio-2 reads. Every value here is a dev fixture — no real
# secret belongs in this file. Locally they are supplied by the IntelliJ run
# config (backend/.run/BootKt.run.xml) or `docker compose up`; real values stay
# out of git (`.env` is gitignored). Per-variable notes: backend/AGENTS.md,
# section "Configuration". The single secrets doc lives in the salgadinhos repo:
# docs/salgadinhos/secrets.md.

KTOR_PORT=8110
LOG_LEVEL=INFO

# Dev telemetry fixtures — no real endpoint or credential. TELEMETRY_CONSOLE=true is the fully
# offline path (console exporters instead of OTLP); prod requires OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_SERVICE_NAME=portfolio
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TELEMETRY_CONSOLE=false

MYSQL_HOST=localhost
MYSQL_PORT=8112
MYSQL_USER=root
MYSQL_PASSWORD=
CHAMEIDOR_TOKEN=dev-portfolio-fixture-token
# Optional: the free brapi tier needs no token; a paid token lifts its three-month clamp.
BRAPI_TOKEN=
