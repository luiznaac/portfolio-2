# The env vars portfolio-2 reads. Every value here is a dev fixture — no real
# secret belongs in this file. Locally they are supplied by the IntelliJ run
# config (backend/.run/BootKt.run.xml) or `docker compose up`; real values stay
# out of git (`.env` is gitignored). Per-variable notes: backend/AGENTS.md,
# section "Configuration". The single secrets doc lives in the salgadinhos repo:
# docs/salgadinhos/secrets.md.

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
CHAMEIDOR_TOKEN=dev-portfolio-fixture-token

# Optional: brapi.dev free-tier token for current quotes (Bearer auth). Empty is valid — the
# current-quote refresh becomes a no-op and callers fall back to the last stored COTAHIST close.
BRAPI_TOKEN=dev-brapi-fixture-token
