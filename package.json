{
  "name": "portfolio-monorepo",
  "private": true,
  "description": "Task runner for the portfolio-2 monorepo (backend/ + frontend/). Not a real Node package — just scripts.",
  "scripts": {
    "setup": "npm --prefix frontend install",
    "be:run": "node scripts/backend-gradle.mjs :application:run --no-daemon",
    "be:unit": "node scripts/backend-gradle.mjs unitTest --no-daemon",
    "be:integration": "node scripts/backend-gradle.mjs :integrationTest:test --no-daemon",
    "be:check": "node scripts/backend-gradle.mjs detekt test --no-daemon",
    "be:test": "node scripts/backend-gradle.mjs test --no-daemon",
    "be:build": "node scripts/backend-gradle.mjs clean build --no-daemon",
    "fe:dev": "npm --prefix frontend run dev",
    "fe:build": "npm --prefix frontend run build",
    "fe:typecheck": "npm --prefix frontend run typecheck",
    "check": "npm run be:check && npm run fe:typecheck && npm run fe:build",
    "db": "docker compose -f backend/docker-compose.yml up -d mysql",
    "db:migrate": "node scripts/backend-gradle.mjs :persistence:migrate --no-daemon",
    "db:generate": "node scripts/backend-gradle.mjs :persistence:generateMigrationScript --no-daemon",
    "up": "docker compose up --build",
    "down": "docker compose down"
  }
}
